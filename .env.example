# Cloudflare Worker secrets / variables
# Do not commit real values. Configure secrets with `wrangler secret put <NAME>`.
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
WEBHOOK_REGISTRATION_SECRET=replace_with_a_random_registration_secret
OPENROUTER_API_KEY=<openrouter_api_key>
CHAT_WHITE_LIST=<telegram_chat_id_1>,<telegram_chat_id_2>
APP_PUBLIC_URL=https://github.com/your-org/telegram-ai-bot
APP_TITLE=Telegram-AI-Bot
